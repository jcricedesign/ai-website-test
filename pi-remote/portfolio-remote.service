[Unit]
Description=Portfolio Display Remote
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=john
WorkingDirectory=/home/john/pi-remote
ExecStart=/usr/bin/python3 /home/john/pi-remote/server.py
Restart=on-failure
RestartSec=2
Environment=PORTFOLIO_REMOTE_HOST=0.0.0.0
Environment=PORTFOLIO_REMOTE_PORT=8765

[Install]
WantedBy=multi-user.target
